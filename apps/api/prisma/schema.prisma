generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  password            String
  role                Role

  isVerified          Boolean  @default(false)
  verificationToken   String?
  verificationExpiry  DateTime?

  resetToken          String?
  resetTokenExpiry    DateTime?
  failedLoginAttempts Int      @default(0)
  lockoutUntil        DateTime?
  tokenVersion        Int      @default(0)
  isActive            Boolean  @default(true)

  passwordHistory     String[] @default([])

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  createdTestCases    TestCase[]      @relation("CreatedTestCases")
  assignedTestCases   TestCase[]      @relation("AssignedTestCases")
  modifiedTestCases   TestCase[]      @relation("ModifiedTestCases")
  createdSuites       TestSuite[]     @relation("CreatedSuites")
  executions          TestExecution[] @relation("ExecutedBy")
  uploadedAttachments Attachment[]    @relation("UploadedBy")
  reportedIssues      Issue[]         @relation("ReportedIssues")
  assignedIssues      Issue[]         @relation("AssignedIssues")
  issueComments       IssueComment[]  @relation("IssueComments")
  auditLogs           AuditLog[]      @relation("AuditActor")
  createdProjects     Project[]       @relation("CreatedProjects")
  createdTemplates    TestCaseTemplate[] @relation("TemplateCreator")
  testCaseVersions    TestCaseVersion[] @relation("TestCaseVersionEditor")
  importJobs          TestCaseImportJob[] @relation("Importer")
  backupJobs          BackupJob[]     @relation("BackupTriggeredBy")
  systemConfigUpdates SystemConfig[]  @relation("ConfigUpdatedBy")
}

model TestCase {
  id           String         @id @default(uuid())
  testCaseCode String?        @unique
  title        String
  description  String
  preConditions Json?
  testDataRequirements Json?
  environmentRequirements Json?
  postConditions Json?
  metadata     Json?
  module       String?
  priority     Priority
  severity     TestSeverity?
  type         TestCaseType?
  status       TestCaseStatus @default(DRAFT)
  steps        Json
  version      Int            @default(1)
  tags         String[]       @default([])
  estimatedDurationMinutes Int?
  automationStatus AutomationStatus @default(NOT_AUTOMATED)
  automationScriptLink String?

  createdBy   String
  assignedTo  String?
  lastModifiedBy String?
  lastModifiedAt DateTime?
  projectId   String?

  isDeleted   Boolean     @default(false)
  deletedAt   DateTime?

  creator     User        @relation("CreatedTestCases", fields: [createdBy], references: [id])
  assignee    User?       @relation("AssignedTestCases", fields: [assignedTo], references: [id])
  lastEditor  User?       @relation("ModifiedTestCases", fields: [lastModifiedBy], references: [id])
  project     Project?    @relation(fields: [projectId], references: [id])
  versionHistory TestCaseVersion[]

  suiteLinks  TestSuiteCase[]
  executions  TestExecution[]
  attachments Attachment[]
  issues      Issue[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([createdBy])
  @@index([assignedTo])
  @@index([projectId])
  @@index([lastModifiedBy])
}

model TestCaseVersion {
  id          String   @id @default(uuid())
  testCaseId  String
  version     Int
  changedBy   String
  changeSummary String
  snapshot    Json
  createdAt   DateTime @default(now())

  testCase    TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  editor      User     @relation("TestCaseVersionEditor", fields: [changedBy], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@index([changedBy])
}

model TestSuite {
  id          String         @id @default(uuid())
  name        String
  description String?
  createdBy   String
  projectId   String?

  creator     User           @relation("CreatedSuites", fields: [createdBy], references: [id])
  project     Project?       @relation(fields: [projectId], references: [id])
  suiteCases  TestSuiteCase[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([createdBy])
  @@index([projectId])
}

model TestSuiteCase {
  id         String    @id @default(uuid())
  suiteId    String
  testCaseId String

  suite      TestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  testCase   TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())

  @@unique([suiteId, testCaseId])
}

model TestExecution {
  id          String          @id @default(uuid())
  testCaseId  String
  executedBy  String
  result      ExecutionStatus
  notes       String?

  testCase    TestCase        @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  executor    User            @relation("ExecutedBy", fields: [executedBy], references: [id])
  issues      Issue[]

  executedAt  DateTime        @default(now())

  @@index([testCaseId])
  @@index([executedBy])
}

model Attachment {
  id          String         @id @default(uuid())
  testCaseId  String
  uploadedBy  String
  fileType    AttachmentType
  fileUrl     String
  fileName    String

  testCase    TestCase       @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  uploader    User           @relation("UploadedBy", fields: [uploadedBy], references: [id])

  createdAt   DateTime       @default(now())

  @@index([testCaseId])
}

model Issue {
  id              String         @id @default(uuid())
  title           String
  description     String
  status          IssueStatus    @default(OPEN)
  severity        Severity       @default(MEDIUM)
  testCaseId      String?
  executionId     String?
  reportedBy      String
  assignedTo      String?
  fixNotes        String?
  commitLink      String?
  retestRequested Boolean        @default(false)

  testCase        TestCase?      @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  execution       TestExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  reporter        User           @relation("ReportedIssues", fields: [reportedBy], references: [id])
  assignee        User?          @relation("AssignedIssues", fields: [assignedTo], references: [id])
  comments        IssueComment[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([assignedTo])
  @@index([reportedBy])
}

model IssueComment {
  id         String   @id @default(uuid())
  issueId    String
  authorId   String
  comment    String
  createdAt  DateTime @default(now())

  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author     User     @relation("IssueComments", fields: [authorId], references: [id])

  @@index([issueId])
}

model Project {
  id          String      @id @default(uuid())
  name        String
  description String?
  isActive    Boolean     @default(true)
  createdBy   String

  creator     User        @relation("CreatedProjects", fields: [createdBy], references: [id])
  testCases   TestCase[]
  testSuites  TestSuite[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model TestCaseTemplate {
  id          String   @id @default(uuid())
  name        String
  category    String?
  description String?
  preConditions Json?
  testDataRequirements Json?
  environmentRequirements Json?
  postConditions Json?
  metadata    Json?
  module      String?
  sourceTestCaseId String?
  severity    TestSeverity @default(MAJOR)
  type        TestCaseType @default(FUNCTIONAL)
  steps       Json
  tags        String[] @default([])
  estimatedDurationMinutes Int?
  automationStatus AutomationStatus @default(NOT_AUTOMATED)
  automationScriptLink String?
  priority    Priority @default(MEDIUM)
  status      TestCaseStatus @default(DRAFT)
  createdBy   String

  creator     User     @relation("TemplateCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdBy])
}

model TestCaseImportJob {
  id           String       @id @default(uuid())
  importedBy   String
  sourceType   ImportSourceType
  totalRecords Int
  successCount Int
  failedCount  Int
  errors       Json?
  createdIds   String[]     @default([])
  createdAt    DateTime     @default(now())

  importer     User         @relation("Importer", fields: [importedBy], references: [id], onDelete: Cascade)

  @@index([importedBy])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([entityType, entityId])
}

model SystemConfig {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  updatedBy  String
  updatedAt  DateTime @updatedAt

  updater    User     @relation("ConfigUpdatedBy", fields: [updatedBy], references: [id], onDelete: Cascade)
}

model BackupJob {
  id          String       @id @default(uuid())
  status      BackupStatus @default(PENDING)
  triggeredBy String
  notes       String?
  startedAt   DateTime     @default(now())
  completedAt DateTime?

  triggerUser User         @relation("BackupTriggeredBy", fields: [triggeredBy], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  TESTER
  DEVELOPER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TestStatus {
  DRAFT
  READY
  IN_PROGRESS
  PASSED
  FAILED
}

enum TestCaseStatus {
  DRAFT
  READY
  IN_PROGRESS
  PASSED
  FAILED
  READY_FOR_REVIEW
  APPROVED
  DEPRECATED
  ARCHIVED
}

enum TestSeverity {
  BLOCKER
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

enum TestCaseType {
  FUNCTIONAL
  REGRESSION
  SMOKE
  INTEGRATION
  UAT
  PERFORMANCE
  SECURITY
  USABILITY
}

enum ExecutionStatus {
  PASSED
  FAILED
  BLOCKED
  SKIPPED
}

enum AttachmentType {
  IMAGE
  VIDEO
  LOG
  DOCUMENT
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  FIXED
  WONT_FIX
  CLOSED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BackupStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum ImportSourceType {
  JSON
  CSV
  EXCEL
}

enum AutomationStatus {
  NOT_AUTOMATED
  IN_PROGRESS
  AUTOMATED
  CANNOT_AUTOMATE
}
