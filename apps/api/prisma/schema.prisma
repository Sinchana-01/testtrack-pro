generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String               @id @default(uuid())
  name                   String
  email                  String               @unique
  password               String
  role                   Role
  isVerified             Boolean              @default(false)
  verificationToken      String?
  verificationExpiry     DateTime?
  resetToken             String?
  resetTokenExpiry       DateTime?
  failedLoginAttempts    Int                  @default(0)
  lockoutUntil           DateTime?
  tokenVersion           Int                  @default(0)
  isActive               Boolean              @default(true)
  passwordHistory        String[]             @default([])
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  uploadedAttachments    Attachment[]         @relation("UploadedBy")
  auditLogs              AuditLog[]           @relation("AuditActor")
  backupJobs             BackupJob[]          @relation("BackupTriggeredBy")
  uploadedBugAttachments BugAttachment[]      @relation("BugAttachmentUploadedBy")
  assignedIssues         Issue[]              @relation("AssignedIssues")
  reportedIssues         Issue[]              @relation("ReportedIssues")
  issueComments          IssueComment[]       @relation("IssueComments")
  createdProjects        Project[]            @relation("CreatedProjects")
  systemConfigUpdates    SystemConfig[]       @relation("ConfigUpdatedBy")
  assignedTestCases      TestCase[]           @relation("AssignedTestCases")
  createdTestCases       TestCase[]           @relation("CreatedTestCases")
  modifiedTestCases      TestCase[]           @relation("ModifiedTestCases")
  importJobs             TestCaseImportJob[]  @relation("Importer")
  createdTemplates       TestCaseTemplate[]   @relation("TemplateCreator")
  testCaseVersions       TestCaseVersion[]    @relation("TestCaseVersionEditor")
  executions             TestExecution[]      @relation("ExecutedBy")
  createdTestRuns        TestRun[]            @relation("CreatedTestRuns")
  testRunAssignments     TestRunAssignment[]  @relation("AssignedTestRuns")
  createdSuites          TestSuite[]          @relation("CreatedSuites")
  addedSuiteCaseLinks    TestSuiteCase[]      @relation("SuiteCaseAddedBy")
  startedSuiteExecutions TestSuiteExecution[] @relation("StartedSuiteExecutions")
}

model TestCase {
  id                       String                   @id @default(uuid())
  testCaseCode             String?                  @unique
  title                    String
  description              String
  preConditions            Json?
  testDataRequirements     Json?
  environmentRequirements  Json?
  postConditions           Json?
  metadata                 Json?
  module                   String?
  priority                 Priority
  severity                 TestSeverity?
  type                     TestCaseType?
  status                   TestCaseStatus           @default(DRAFT)
  steps                    Json
  version                  Int                      @default(1)
  tags                     String[]                 @default([])
  estimatedDurationMinutes Int?
  automationStatus         AutomationStatus         @default(NOT_AUTOMATED)
  automationScriptLink     String?
  createdBy                String
  assignedTo               String?
  lastModifiedBy           String?
  lastModifiedAt           DateTime?
  projectId                String?
  isDeleted                Boolean                  @default(false)
  deletedAt                DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  attachments              Attachment[]
  issues                   Issue[]
  assignee                 User?                    @relation("AssignedTestCases", fields: [assignedTo], references: [id])
  creator                  User                     @relation("CreatedTestCases", fields: [createdBy], references: [id])
  lastEditor               User?                    @relation("ModifiedTestCases", fields: [lastModifiedBy], references: [id])
  project                  Project?                 @relation(fields: [projectId], references: [id])
  versionHistory           TestCaseVersion[]
  executions               TestExecution[]
  testRunCases             TestRunCase[]
  suiteLinks               TestSuiteCase[]
  suiteExecutionCases      TestSuiteExecutionCase[]

  @@index([createdBy])
  @@index([assignedTo])
  @@index([projectId])
  @@index([lastModifiedBy])
}

model TestCaseVersion {
  id            String   @id @default(uuid())
  testCaseId    String
  version       Int
  changedBy     String
  changeSummary String
  snapshot      Json
  createdAt     DateTime @default(now())
  editor        User     @relation("TestCaseVersionEditor", fields: [changedBy], references: [id], onDelete: Cascade)
  testCase      TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@index([changedBy])
}

model TestRun {
  id              String               @id @default(uuid())
  name            String
  description     String?
  createdBy       String
  targetStartDate DateTime?
  targetEndDate   DateTime?
  status          TestRunStatus        @default(PLANNED)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  executions      TestExecution[]
  creator         User                 @relation("CreatedTestRuns", fields: [createdBy], references: [id], onDelete: Cascade)
  assignments     TestRunAssignment[]
  testCases       TestRunCase[]
  suiteExecutions TestSuiteExecution[]

  @@index([createdBy])
  @@index([status])
}

model TestRunAssignment {
  id         String   @id @default(uuid())
  testRunId  String
  testerId   String
  assignedAt DateTime @default(now())
  testRun    TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  tester     User     @relation("AssignedTestRuns", fields: [testerId], references: [id], onDelete: Cascade)

  @@unique([testRunId, testerId])
  @@index([testerId])
}

model TestRunCase {
  id              String            @id @default(uuid())
  testRunId       String
  testCaseId      String
  status          TestRunCaseStatus @default(NOT_RUN)
  lastExecutionId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lastExecution   TestExecution?    @relation("RunCaseLastExecution", fields: [lastExecutionId], references: [id])
  testCase        TestCase          @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testRun         TestRun           @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  @@unique([testRunId, testCaseId])
  @@index([testCaseId])
}

model TestSuite {
  id             String                   @id @default(uuid())
  name           String
  description    String?
  createdBy      String
  projectId      String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  isArchived     Boolean                  @default(false)
  module         String?
  parentSuiteId  String?
  type           SuiteType                @default(STATIC)
  filterJson     Json?
  creator        User                     @relation("CreatedSuites", fields: [createdBy], references: [id])
  parentSuite    TestSuite?               @relation("SuiteHierarchy", fields: [parentSuiteId], references: [id])
  childSuites    TestSuite[]              @relation("SuiteHierarchy")
  project        Project?                 @relation(fields: [projectId], references: [id])
  suiteCases     TestSuiteCase[]
  executions     TestSuiteExecution[]
  executionCases TestSuiteExecutionCase[]

  @@index([createdBy])
  @@index([projectId])
  @@index([parentSuiteId])
  @@index([isArchived])
  @@index([type])
}

model TestSuiteCase {
  id                  String                   @id @default(uuid())
  suiteId             String
  testCaseId          String
  createdAt           DateTime                 @default(now())
  addedBy             String?
  position            Int                      @default(0)
  addedByUser         User?                    @relation("SuiteCaseAddedBy", fields: [addedBy], references: [id])
  suite               TestSuite                @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  testCase            TestCase                 @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  suiteExecutionCases TestSuiteExecutionCase[]

  @@unique([suiteId, testCaseId])
  @@index([suiteId, position])
}

model TestSuiteExecution {
  id              String                   @id @default(uuid())
  suiteId         String
  startedBy       String
  mode            SuiteExecutionMode
  status          SuiteExecutionStatus     @default(PLANNED)
  linkedTestRunId String?
  totalCases      Int                      @default(0)
  passed          Int                      @default(0)
  failed          Int                      @default(0)
  blocked         Int                      @default(0)
  skipped         Int                      @default(0)
  passRate        Float?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  linkedTestRun   TestRun?                 @relation(fields: [linkedTestRunId], references: [id])
  starter         User                     @relation("StartedSuiteExecutions", fields: [startedBy], references: [id], onDelete: Cascade)
  suite           TestSuite                @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  cases           TestSuiteExecutionCase[]

  @@index([suiteId])
  @@index([startedBy])
  @@index([linkedTestRunId])
  @@index([status])
}

model TestSuiteExecutionCase {
  id               String             @id @default(uuid())
  suiteExecutionId String
  suiteId          String
  suiteCaseId      String
  testCaseId       String
  position         Int
  status           TestRunCaseStatus  @default(NOT_RUN)
  executionId      String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  execution        TestExecution?     @relation(fields: [executionId], references: [id])
  suiteCase        TestSuiteCase      @relation(fields: [suiteCaseId], references: [id], onDelete: Cascade)
  suiteExecution   TestSuiteExecution @relation(fields: [suiteExecutionId], references: [id], onDelete: Cascade)
  suite            TestSuite          @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  testCase         TestCase           @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([suiteExecutionId, suiteCaseId])
  @@index([suiteExecutionId, status])
  @@index([suiteId])
  @@index([testCaseId])
  @@index([executionId])
}

model TestExecution {
  id                 String                   @id @default(uuid())
  testCaseId         String
  executedBy         String
  result             ExecutionStatus
  notes              String?
  executedAt         DateTime                 @default(now())
  isDraft            Boolean                  @default(false)
  progressPercent    Int                      @default(0)
  stepResults        Json?
  testRunId          String?
  updatedAt          DateTime                 @updatedAt
  issues             Issue[]
  executor           User                     @relation("ExecutedBy", fields: [executedBy], references: [id])
  testCase           TestCase                 @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testRun            TestRun?                 @relation(fields: [testRunId], references: [id])
  runCaseRefs        TestRunCase[]            @relation("RunCaseLastExecution")
  suiteExecutionRefs TestSuiteExecutionCase[]

  @@index([testCaseId])
  @@index([executedBy])
  @@index([testRunId])
}

model Attachment {
  id         String         @id @default(uuid())
  testCaseId String
  uploadedBy String
  fileType   AttachmentType
  fileUrl    String
  fileName   String
  createdAt  DateTime       @default(now())
  testCase   TestCase       @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  uploader   User           @relation("UploadedBy", fields: [uploadedBy], references: [id])

  @@index([testCaseId])
}

model Issue {
  id               String            @id @default(uuid())
  title            String
  description      String
  status           IssueStatus       @default(OPEN)
  severity         Severity          @default(MEDIUM)
  testCaseId       String?
  executionId      String?
  reportedBy       String
  assignedTo       String?
  fixNotes         String?
  commitLink       String?
  retestRequested  Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  actualBehavior   String?
  affectedVersion  String?
  bugCode          String?           @unique
  bugPriority      BugPriority       @default(P3_MEDIUM)
  dueDate          DateTime?
  environment      String?
  expectedBehavior String?
  stepsToReproduce String?
  workflowStatus   BugWorkflowStatus @default(NEW)
  attachments      BugAttachment[]
  assignee         User?             @relation("AssignedIssues", fields: [assignedTo], references: [id])
  execution        TestExecution?    @relation(fields: [executionId], references: [id])
  reporter         User              @relation("ReportedIssues", fields: [reportedBy], references: [id])
  testCase         TestCase?         @relation(fields: [testCaseId], references: [id])
  comments         IssueComment[]

  @@index([assignedTo])
  @@index([reportedBy])
}

model IssueComment {
  id        String   @id @default(uuid())
  issueId   String
  authorId  String
  comment   String
  createdAt DateTime @default(now())
  author    User     @relation("IssueComments", fields: [authorId], references: [id])
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model Project {
  id          String      @id @default(uuid())
  name        String
  description String?
  isActive    Boolean     @default(true)
  createdBy   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  creator     User        @relation("CreatedProjects", fields: [createdBy], references: [id])
  testCases   TestCase[]
  testSuites  TestSuite[]
}

model TestCaseTemplate {
  id                       String           @id @default(uuid())
  name                     String
  category                 String?
  description              String?
  preConditions            Json?
  testDataRequirements     Json?
  environmentRequirements  Json?
  postConditions           Json?
  metadata                 Json?
  module                   String?
  sourceTestCaseId         String?
  severity                 TestSeverity     @default(MAJOR)
  type                     TestCaseType     @default(FUNCTIONAL)
  steps                    Json
  tags                     String[]         @default([])
  estimatedDurationMinutes Int?
  automationStatus         AutomationStatus @default(NOT_AUTOMATED)
  automationScriptLink     String?
  priority                 Priority         @default(MEDIUM)
  status                   TestCaseStatus   @default(DRAFT)
  createdBy                String
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  creator                  User             @relation("TemplateCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy])
}

model TestCaseImportJob {
  id           String           @id @default(uuid())
  importedBy   String
  sourceType   ImportSourceType
  totalRecords Int
  successCount Int
  failedCount  Int
  errors       Json?
  createdIds   String[]         @default([])
  createdAt    DateTime         @default(now())
  importer     User             @relation("Importer", fields: [importedBy], references: [id], onDelete: Cascade)

  @@index([importedBy])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([entityType, entityId])
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedBy String
  updatedAt DateTime @updatedAt
  updater   User     @relation("ConfigUpdatedBy", fields: [updatedBy], references: [id], onDelete: Cascade)
}

model BackupJob {
  id          String       @id @default(uuid())
  status      BackupStatus @default(PENDING)
  triggeredBy String
  notes       String?
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  triggerUser User         @relation("BackupTriggeredBy", fields: [triggeredBy], references: [id], onDelete: Cascade)
}

model BugAttachment {
  id         String         @id @default(uuid())
  issueId    String
  uploadedBy String
  fileType   AttachmentType
  fileUrl    String
  fileName   String
  notes      String?
  createdAt  DateTime       @default(now())
  issue      Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploader   User           @relation("BugAttachmentUploadedBy", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([uploadedBy])
}

enum Role {
  ADMIN
  TESTER
  DEVELOPER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TestStatus {
  DRAFT
  READY
  IN_PROGRESS
  PASSED
  FAILED
}

enum TestCaseStatus {
  DRAFT
  READY
  IN_PROGRESS
  PASSED
  FAILED
  READY_FOR_REVIEW
  APPROVED
  DEPRECATED
  ARCHIVED
}

enum TestSeverity {
  BLOCKER
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

enum TestCaseType {
  FUNCTIONAL
  REGRESSION
  SMOKE
  INTEGRATION
  UAT
  PERFORMANCE
  SECURITY
  USABILITY
}

enum ExecutionStatus {
  PASSED
  FAILED
  BLOCKED
  SKIPPED
}

enum TestRunStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TestRunCaseStatus {
  NOT_RUN
  PASSED
  FAILED
  BLOCKED
  SKIPPED
}

enum SuiteExecutionMode {
  SEQUENTIAL
  PARALLEL
}

enum SuiteExecutionStatus {
  PLANNED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum BugPriority {
  P1_URGENT
  P2_HIGH
  P3_MEDIUM
  P4_LOW
}

enum BugWorkflowStatus {
  NEW
  OPEN
  IN_PROGRESS
  FIXED
  VERIFIED
  CLOSED
  REOPENED
  WONT_FIX
  DUPLICATE
}

enum AttachmentType {
  IMAGE
  VIDEO
  LOG
  DOCUMENT
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  FIXED
  WONT_FIX
  CLOSED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BackupStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum ImportSourceType {
  JSON
  CSV
  EXCEL
}

enum AutomationStatus {
  NOT_AUTOMATED
  IN_PROGRESS
  AUTOMATED
  CANNOT_AUTOMATE
}

enum SuiteType {
  STATIC
  DYNAMIC
}
